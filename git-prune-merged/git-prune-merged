#!/usr/bin/env bash
# git-prune-merged - Clean up branches and worktrees already in master (rebase-aware)
# Uses git cherry (patch-id comparison) instead of --merged (SHA comparison).
# Also treats a branch as prunable if it has a closed-but-unmerged PR (via gh),
# since an abandoned/superseded PR's branch is just as dead as a merged one.

set -euo pipefail

PROTECTED="master main develop staging production release"

# Lazily populated by fetch_closed_prs(): "headRefName<TAB>number" lines for
# closed (not merged) PRs. GH_OK stays false if gh is missing, unauthenticated,
# or rate-limited — closed-PR pruning silently degrades to merged-only in that
# case rather than failing the whole run.
GH_CHECKED=false
GH_OK=false
CLOSED_PR_CACHE=""

usage() {
  cat <<'EOF'
Usage: git prune-merged <command> [options]

Commands:
  branches    List (or delete) local branches fully merged (or closed-unmerged) into base
  worktrees   List (or delete) worktrees whose branches are fully merged (or closed-unmerged)

Options:
  --delete    Actually delete (default is dry-run)
  --base REF  Compare against this branch (default: master)

A branch/worktree is prunable if either:
  - all its commits are already in base (rebase-aware, via git cherry), or
  - it has a closed (not merged) PR on GitHub (via gh; degrades silently if
    gh is unavailable/unauthenticated/rate-limited)

Examples:
  git prune-merged branches              # dry-run: show merged/closed branches
  git prune-merged branches --delete     # delete them
  git prune-merged worktrees             # dry-run: show merged/closed worktrees
  git prune-merged worktrees --delete    # remove them and their branches
EOF
  exit 1
}

is_protected() {
  local branch="$1"
  for p in $PROTECTED; do
    [[ "$branch" == "$p" ]] && return 0
  done
  return 1
}

current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || echo ""
}

# Check if all commits on branch are in base (all lines start with -)
is_fully_merged() {
  local base="$1" branch="$2"
  # If cherry produces no output, branch has no unique commits (same as base)
  local output
  output=$(git cherry "$base" "$branch" 2>/dev/null) || return 1
  [[ -z "$output" ]] && return 0
  # If any line starts with +, branch has unmerged commits
  ! echo "$output" | grep -q '^\+'
}

# One-shot, best-effort fetch of closed-but-unmerged PRs. Never fails the
# script — any error just leaves GH_OK=false and callers fall back to
# merged-only detection.
fetch_closed_prs() {
  $GH_CHECKED && return
  GH_CHECKED=true

  command -v gh >/dev/null 2>&1 || return
  command -v jq >/dev/null 2>&1 || return

  local json
  json=$(gh pr list --state closed --json headRefName,number,mergedAt --limit 500 2>/dev/null) || return
  echo "$json" | jq -e . >/dev/null 2>&1 || return

  GH_OK=true
  CLOSED_PR_CACHE=$(echo "$json" | jq -r '.[] | select(.mergedAt == null) | "\(.headRefName)\t\(.number)"')
}

# Prints the PR number on stdout and returns 0 if branch has a closed
# (not merged) PR; returns 1 otherwise.
closed_pr_number() {
  local branch="$1"
  $GH_OK || return 1
  [[ -z "$CLOSED_PR_CACHE" ]] && return 1
  local num
  num=$(awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }' <<<"$CLOSED_PR_CACHE")
  [[ -n "$num" ]] || return 1
  echo "$num"
}

# Prints "merged" or "closed:<PR#>" and returns 0 if branch should be
# considered prunable; returns 1 if it's still live.
prune_status() {
  local base="$1" branch="$2"
  if is_fully_merged "$base" "$branch"; then
    echo "merged"
    return 0
  fi

  fetch_closed_prs
  local prnum
  if prnum=$(closed_pr_number "$branch"); then
    echo "closed:$prnum"
    return 0
  fi
  return 1
}

# Formats a prune_status value ("merged" / "closed:N") into a parenthetical
# suffix for display — empty for merged (the row prefix already says so),
# "PR #N" for closed (disambiguates from a merged PR).
status_suffix() {
  local status="$1"
  if [[ "$status" == closed:* ]]; then
    echo ", PR #${status#closed:}"
  fi
}

cmd_branches() {
  local base="master" delete=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delete) delete=true; shift ;;
      --base) base="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  local current
  current=$(current_branch)
  local found=0

  for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
    is_protected "$branch" && continue
    [[ "$branch" == "$current" ]] && continue

    local status
    if ! status=$(prune_status "$base" "$branch"); then
      continue
    fi
    found=1

    local sha suffix
    sha=$(git rev-parse --short "$branch")
    suffix=$(status_suffix "$status")

    if $delete; then
      if git branch -D "$branch" >/dev/null 2>&1; then
        echo "  deleted  $branch (was $sha$suffix)"
      else
        echo "  FAILED   $branch — could not delete (checked out in a worktree?)"
      fi
    else
      if [[ "$status" == closed:* ]]; then
        echo "  closed   $branch ($sha$suffix)"
      else
        echo "  merged   $branch ($sha)"
      fi
    fi
  done

  if [[ $found -eq 0 ]]; then
    echo "No merged or closed-unmerged branches found."
  elif ! $delete; then
    echo ""
    echo "Run with --delete to remove these branches."
  fi
}

cmd_worktrees() {
  local base="master" delete=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delete) delete=true; shift ;;
      --base) base="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  local found=0

  # Parse worktree list (skip the main worktree — first entry)
  local first=true
  local wt_path="" wt_branch=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^worktree\ (.+) ]]; then
      # Process previous worktree (if any)
      if [[ -n "$wt_path" && -n "$wt_branch" ]]; then
        _check_worktree "$base" "$wt_path" "$wt_branch" "$delete" && found=1
      fi
      wt_path="${BASH_REMATCH[1]}"
      wt_branch=""
      if $first; then
        # Skip main worktree
        first=false
        wt_path=""
      fi
    elif [[ "$line" =~ ^branch\ refs/heads/(.+) ]]; then
      wt_branch="${BASH_REMATCH[1]}"
    elif [[ "$line" == "locked" ]]; then
      # Skip locked worktrees
      wt_path=""
      wt_branch=""
    fi
  done < <(git worktree list --porcelain)

  # Process last entry
  if [[ -n "$wt_path" && -n "$wt_branch" ]]; then
    _check_worktree "$base" "$wt_path" "$wt_branch" "$delete" && found=1
  fi

  if [[ $found -eq 0 ]]; then
    echo "No merged or closed-unmerged worktrees found."
  elif ! $delete; then
    echo ""
    echo "Run with --delete to remove these worktrees and their branches."
  fi
}

_check_worktree() {
  local base="$1" wt_path="$2" wt_branch="$3" delete="$4"

  is_protected "$wt_branch" && return 1

  local status
  if ! status=$(prune_status "$base" "$wt_branch"); then
    return 1
  fi

  # Check for uncommitted changes
  if [[ -n $(git -C "$wt_path" status --porcelain 2>/dev/null) ]]; then
    echo "  DIRTY    $wt_path ($wt_branch) — has uncommitted changes, skipping"
    return 0
  fi

  # Check for active processes
  if lsof +D "$wt_path" >/dev/null 2>&1; then
    echo "  IN USE   $wt_path ($wt_branch) — processes running, skipping"
    return 0
  fi

  local sha suffix
  sha=$(git rev-parse --short "$wt_branch")
  suffix=$(status_suffix "$status")

  if $delete; then
    if git worktree remove "$wt_path" 2>&1; then
      git branch -D "$wt_branch" >/dev/null 2>&1
      echo "  removed  $wt_path ($wt_branch, was $sha$suffix)"
    else
      echo "  FAILED   $wt_path ($wt_branch) — could not remove worktree, skipping"
    fi
  else
    if [[ "$status" == closed:* ]]; then
      echo "  closed   $wt_path ($wt_branch, $sha$suffix)"
    else
      echo "  merged   $wt_path ($wt_branch, $sha)"
    fi
  fi

  return 0
}

# --- Main ---

[[ $# -lt 1 ]] && usage

command="$1"; shift

case "$command" in
  branches)  cmd_branches "$@" ;;
  worktrees) cmd_worktrees "$@" ;;
  -h|--help) usage ;;
  *)         echo "Unknown command: $command"; usage ;;
esac
