#!/bin/bash
set -euo pipefail

REAL_SCRIPT="$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$REAL_SCRIPT")"

source "$SCRIPT_DIR/render-common.sh"
source "$SCRIPT_DIR/../cli-envelope.sh"

TOOL_NAME="render-logs"

# Defaults
LINES=50
LOG_TYPES=()      # API supports array of strings
LOG_LEVELS=()     # API supports array of strings
LOG_TEXTS=()      # API text filter (server-side, regex/wildcards)
LOG_PATHS=()      # API path filter (server-side, regex/wildcards)
LOG_STATUSES=()   # API status code filter (server-side, regex/wildcards)
LOG_METHODS=()    # API HTTP method filter (server-side)
LOG_HOSTS=()      # API host filter (server-side)
LOG_INSTANCES=()  # API instance id filter (server-side)
SINCE=""
START_TIME=""
END_TIME=""
DIRECTION=""
GREP_PATTERN=""   # Client-side fallback filter
STATS_MODE=false

# --- Client-side arg validation (fail fast, before any Render API call) ---
#
# Render's /logs `level` param has no server-side enum — an unrecognized
# value like "warn" just silently matches nothing, no error. That's a
# trap for an agent: it reads "0 error lines" and moves on, never learning
# its filter was wrong. Validate the fixed value list ourselves, but pass
# /regex/ and *wildcard* forms through unchanged — those are legitimate
# server-side syntax per Render's docs, not typos.
validate_level() {
    local val="$1"
    if [[ "$val" =~ ^/.*/$ ]] || [[ "$val" == *"*"* ]]; then
        return 0
    fi
    case "$val" in
        debug|info|notice|warning|error|critical|alert|emergency)
            return 0
            ;;
    esac
    local suggestion=""
    case "$val" in
        warn|warn?*) suggestion="warning" ;;
        err|err?*) suggestion="error" ;;
        fatal|fatal?*|crit|crit?*) suggestion="critical" ;;
    esac
    if [[ -n "$suggestion" ]]; then
        json_error "$TOOL_NAME" "Invalid --level value: '$val'" "INVALID_ARG" "Did you mean '$suggestion'? Valid values: debug, info, notice, warning, error, critical, alert, emergency (or /regex/, *wildcard*)"
    else
        json_error "$TOOL_NAME" "Invalid --level value: '$val'" "INVALID_ARG" "Valid values: debug, info, notice, warning, error, critical, alert, emergency (or /regex/, *wildcard*)"
    fi
}

validate_direction() {
    local val="$1"
    case "$val" in
        forward|backward) return 0 ;;
    esac
    json_error "$TOOL_NAME" "Invalid --direction value: '$val'" "INVALID_ARG" "Valid values: forward, backward"
}

validate_lines() {
    local val="$1"
    if [[ ! "$val" =~ ^[0-9]+$ ]] || [[ "$val" -eq 0 ]]; then
        json_error "$TOOL_NAME" "Invalid --lines value: '$val'" "INVALID_ARG" "Must be a positive integer"
    fi
}

# Parse arguments
SERVICE_ID=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --lines|-n)
            validate_lines "$2"
            LINES="$2"
            shift 2
            ;;
        --type)
            LOG_TYPES+=("$2")
            shift 2
            ;;
        --level)
            validate_level "$2"
            LOG_LEVELS+=("$2")
            shift 2
            ;;
        --text|-t)
            LOG_TEXTS+=("$2")
            shift 2
            ;;
        --path)
            LOG_PATHS+=("$2")
            shift 2
            ;;
        --status)
            LOG_STATUSES+=("$2")
            shift 2
            ;;
        --method)
            LOG_METHODS+=("$2")
            shift 2
            ;;
        --host)
            LOG_HOSTS+=("$2")
            shift 2
            ;;
        --instance)
            LOG_INSTANCES+=("$2")
            shift 2
            ;;
        --since)
            SINCE="$2"
            shift 2
            ;;
        --start)
            START_TIME="$2"
            shift 2
            ;;
        --end)
            END_TIME="$2"
            shift 2
            ;;
        --direction)
            validate_direction "$2"
            DIRECTION="$2"
            shift 2
            ;;
        --grep|-g)
            GREP_PATTERN="$2"
            # Fail before ever hitting the API rather than silently
            # returning zero matches for every page (see the per-page
            # filter below, which treats a jq failure the same way).
            if ! jq -n --arg pat "$GREP_PATTERN" '"" | test($pat)' >/dev/null 2>/dev/null; then
                json_error "$TOOL_NAME" "Invalid --grep pattern: $GREP_PATTERN" "INVALID_ARG" "Provide a valid regex for --grep"
            fi
            shift 2
            ;;
        --stats)
            STATS_MODE=true
            shift
            ;;
        --help|-h)
            cmd_tree "$TOOL_NAME" "Render.com log viewer" "$(jq -n '[
                {name: "logs", description: "Fetch logs for a service", usage: "render-logs <service-id> [options]"},
                {name: "--text PATTERN", description: "Server-side text filter (regex/wildcards supported, can repeat)", usage: "--text \"generate\" --text \"error\""},
                {name: "--path PATTERN", description: "Server-side request path filter (regex/wildcards)", usage: "--path \"/api/accounts/*/generate\""},
                {name: "--type TYPE", description: "Log type filter: app, request, build (can repeat)", usage: "--type app --type request"},
                {name: "--level LEVEL", description: "Severity filter: debug, info, notice, warning, error, critical, alert, emergency (can repeat; /regex/ or *wildcard* also accepted)", usage: "--level warning"},
                {name: "--status CODE", description: "Server-side HTTP status code filter (can repeat, regex/wildcards supported)", usage: "--status 500"},
                {name: "--method METHOD", description: "Server-side HTTP method filter (can repeat)", usage: "--method POST"},
                {name: "--host HOST", description: "Server-side host filter (can repeat)", usage: "--host example.onrender.com"},
                {name: "--instance ID", description: "Server-side instance id filter (can repeat)", usage: "--instance srv-xxxxx"},
                {name: "--grep PATTERN", description: "Client-side regex filter (fallback when API filters are insufficient)", usage: "--grep \"status=[45][0-9]{2}\""},
                {name: "--stats", description: "Return summary stats: counts by day/level/status/endpoint, duration percentiles", usage: "--stats --text \"generate\" --since 1d"},
                {name: "--since TIME", description: "Relative time: 1h, 30m, 7d. Defaults to newest-first within the window (direction=backward) so you see what just happened, not the oldest match after the cutoff", usage: "--since 1d"},
                {name: "--start/--end", description: "Absolute time bounds (RFC3339)", usage: "--start 2026-02-25T00:00:00Z"},
                {name: "--lines N", description: "Max lines to return (default 50, must be a positive integer)", usage: "--lines 200"},
                {name: "--direction", description: "forward (oldest-first) or backward (newest-first — the default, and the default for --since too)", usage: "--direction forward"}
            ]')"
            exit 0
            ;;
        -*)
            json_error "$TOOL_NAME" "Unknown option: $1" "INVALID_ARG" "Run: render-logs --help"
            ;;
        *)
            SERVICE_ID="$1"
            shift
            ;;
    esac
done

if [[ -z "$SERVICE_ID" ]]; then
    cmd_tree "$TOOL_NAME" "Render.com log viewer" "$(jq -n '[
        {name: "logs", description: "Fetch logs for a service", usage: "render-logs <service-id> [--text PATTERN] [--path PATTERN] [--type app] [--level error] [--since 1h] [--stats]"}
    ]')"
    exit 0
fi

load_api_key || json_error "$TOOL_NAME" "RENDER_API_KEY not found" "AUTH_MISSING" "Set it in .env or ~/.config/render/api_key"

OWNER_ID=$(load_workspace) || true
if [[ -z "$OWNER_ID" ]]; then
    json_error "$TOOL_NAME" "No workspace selected" "NOT_FOUND" "Run: render-workspace select <owner-id>"
fi

# Convert relative time to RFC3339 helper
parse_relative_time() {
    local time_spec="$1"
    local result=""

    if [[ "$time_spec" =~ ^[0-9]{4}- ]]; then
        echo "$time_spec"
        return 0
    elif [[ "$time_spec" =~ ^([0-9]+)d$ ]]; then
        local days="${BASH_REMATCH[1]}"
        result=$(date -u -v-"${days}d" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
                 date -u -d "${days} days ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
    elif [[ "$time_spec" =~ ^([0-9]+)h$ ]]; then
        local hours="${BASH_REMATCH[1]}"
        result=$(date -u -v-"${hours}H" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
                 date -u -d "${hours} hours ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
    elif [[ "$time_spec" =~ ^([0-9]+)m$ ]]; then
        local mins="${BASH_REMATCH[1]}"
        result=$(date -u -v-"${mins}M" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
                 date -u -d "${mins} minutes ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
    fi

    if [[ -n "$result" ]]; then
        echo "$result"
        return 0
    fi
    return 1
}

# Handle --since: converts to startTime. Defaults to backward (newest
# first, bounded by the window) — an agent diagnosing "what just broke"
# wants the most recent matches, not the oldest ones right after the
# cutoff. `--direction forward` still overrides for old-to-new order.
if [[ -n "$SINCE" ]]; then
    COMPUTED_START_TIME=$(parse_relative_time "$SINCE") || \
        json_error "$TOOL_NAME" "Could not parse time: $SINCE" "INVALID_ARG" "Use relative time like '1h', '30m', '7d' or RFC3339 format"
    START_TIME="$COMPUTED_START_TIME"
    if [[ -z "$DIRECTION" ]]; then
        DIRECTION="backward"
    fi
fi

# Default direction is backward if not set
if [[ -z "$DIRECTION" ]]; then
    DIRECTION="backward"
fi

# Render API caps at 100 per page. Paginate to collect up to $LINES.
PAGE_SIZE=100
if [[ "$LINES" -lt "$PAGE_SIZE" ]]; then
    PAGE_SIZE="$LINES"
fi

# Build base query params (without time cursors — those change per page)
BASE_PARAMS="ownerId=$OWNER_ID&resource=$SERVICE_ID&limit=$PAGE_SIZE&direction=$DIRECTION"

# URL-encode helper (avoids spawning python per param)
urlencode() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$1"; }

# Append array params (API supports multiple values for these fields)
for t in "${LOG_TYPES[@]+"${LOG_TYPES[@]}"}"; do
    [[ -n "$t" ]] && BASE_PARAMS="$BASE_PARAMS&type=$(urlencode "$t")"
done
for l in "${LOG_LEVELS[@]+"${LOG_LEVELS[@]}"}"; do
    [[ -n "$l" ]] && BASE_PARAMS="$BASE_PARAMS&level=$(urlencode "$l")"
done
for txt in "${LOG_TEXTS[@]+"${LOG_TEXTS[@]}"}"; do
    [[ -n "$txt" ]] && BASE_PARAMS="$BASE_PARAMS&text=$(urlencode "$txt")"
done
for p in "${LOG_PATHS[@]+"${LOG_PATHS[@]}"}"; do
    [[ -n "$p" ]] && BASE_PARAMS="$BASE_PARAMS&path=$(urlencode "$p")"
done
for s in "${LOG_STATUSES[@]+"${LOG_STATUSES[@]}"}"; do
    [[ -n "$s" ]] && BASE_PARAMS="$BASE_PARAMS&statusCode=$(urlencode "$s")"
done
for m in "${LOG_METHODS[@]+"${LOG_METHODS[@]}"}"; do
    [[ -n "$m" ]] && BASE_PARAMS="$BASE_PARAMS&method=$(urlencode "$m")"
done
for h in "${LOG_HOSTS[@]+"${LOG_HOSTS[@]}"}"; do
    [[ -n "$h" ]] && BASE_PARAMS="$BASE_PARAMS&host=$(urlencode "$h")"
done
for i in "${LOG_INSTANCES[@]+"${LOG_INSTANCES[@]}"}"; do
    [[ -n "$i" ]] && BASE_PARAMS="$BASE_PARAMS&instance=$(urlencode "$i")"
done

# Initial time bounds (may be empty)
CUR_START="$START_TIME"
CUR_END="$END_TIME"

# Collect entries across pages using files, not shell/argv-carried JSON —
# see the per-page write below for why.
WORKDIR=$(mktemp -d)
MERGED_FILE=$(mktemp)
RENDER_API_BUDGET_FILE=$(mktemp)
echo 0 > "$RENDER_API_BUDGET_FILE"
export RENDER_API_BUDGET_FILE
trap 'rm -rf "$WORKDIR"; rm -f "$MERGED_FILE" "$RENDER_API_BUDGET_FILE"' EXIT

COLLECTED=0       # matched entries (post-grep if applicable)
SCANNED=0         # total entries fetched from API
PARTIAL=false
PARTIAL_REASON=""
MAX_PAGES=50      # Safety limit
# When collecting stats, scan more pages to get a fuller picture
if [[ "$STATS_MODE" == true ]]; then
    MAX_PAGES=100
fi

for (( page=0; page<MAX_PAGES; page++ )); do
    PARAMS="$BASE_PARAMS"
    if [[ -n "$CUR_START" ]]; then
        PARAMS="$PARAMS&startTime=$CUR_START"
    fi
    if [[ -n "$CUR_END" ]]; then
        PARAMS="$PARAMS&endTime=$CUR_END"
    fi

    # Fetch and sanitize: strip control chars.
    #
    # `if ! raw=$(...); then` (instead of an unguarded `raw=$(...)`) is
    # load-bearing. `render_api` calls `json_error` on any HTTP failure,
    # which prints a JSON envelope to stdout and exits 1. Command
    # substitution captures that JSON into $raw regardless of exit code —
    # but an unguarded assignment under `set -e` would abort the script
    # the instant the substitution reports non-zero, before this line
    # ever gets to look at (let alone print) $raw. Using the assignment as
    # an `if` condition is exempt from errexit by bash's own rules, so we
    # get to inspect $raw and decide what to do instead of dying silently.
    #
    # Note: don't try to read $? inside this then-branch for the "real"
    # failure code — `!` reports the LOGICAL NEGATION of the command's
    # status as $?, so right after `if ! cmd; then`, $? is always 0
    # (that's simply what caused us to enter the then-branch in the first
    # place). The actual failure detail lives in $raw's JSON, not in $?.
    if ! raw=$(render_api "/logs?$PARAMS" | LC_ALL=C tr -d '\000-\010\013\014\016-\037'); then
        error_code=$(printf '%s' "$raw" | jq -r '.error.code // empty' 2>/dev/null)
        if [[ "$error_code" == "RATE_LIMITED" ]]; then
            # Retry budget exhausted mid-pagination — return whatever we
            # already collected instead of throwing it all away.
            PARTIAL=true
            PARTIAL_REASON="rate_limited"
            break
        fi
        # Any other HTTP/network failure (401, 404, NETWORK_ERROR, ...)
        # will fail identically on every subsequent page too — surface
        # the ready-made envelope render_api already built and stop with
        # a non-zero exit so shell callers can tell success from failure.
        printf '%s\n' "$raw"
        exit 1
    fi

    # Parse this page. A parse failure here (invalid JSON, an HTML error
    # page from some intermediary, an unexpected shape) must be a loud
    # error, not a silently-empty page — this replaces the old
    # `|| page_entries="[]"` which made a real API problem look
    # indistinguishable from a normal zero-result page.
    page_err_file=$(mktemp)
    if ! page_entries=$(printf '%s' "$raw" | jq -c '
        [.logs[]? | (.labels // []) as $labels
            | ($labels | map({(.name): .value}) | add // {}) as $lbl
            | {
                id: (.id // null),
                timestamp: ((.timestamp // "") | sub("\\.[0-9]+"; "")),
                level: ($lbl.level // "info"),
                type: ($lbl.type // null),
                statusCode: ($lbl.statusCode // null),
                method: ($lbl.method // null),
                path: ($lbl.path // null),
                host: ($lbl.host // null),
                instance: ($lbl.instance // null),
                message: (.message // "")
            }]
    ' 2>"$page_err_file"); then
        err_detail=$(tr -d '\n' < "$page_err_file" | head -c 300)
        rm -f "$page_err_file"
        json_error "$TOOL_NAME" "Failed to parse log page from Render API: ${err_detail:-unknown parse error}" "PARSE_ERROR" "The API response was not the expected shape — this may indicate a transient upstream issue"
    fi
    rm -f "$page_err_file"

    page_count=$(echo "$page_entries" | jq 'length' 2>/dev/null) || page_count=0

    if [[ "$page_count" -eq 0 ]]; then
        break
    fi

    SCANNED=$((SCANNED + page_count))

    # Apply client-side grep filter if set (on top of server-side filters).
    # The pattern was already validated at parse time (see --grep above),
    # so a failure here would be unexpected — treat it loudly too, rather
    # than silently coercing to zero matches.
    if [[ -n "$GREP_PATTERN" ]]; then
        grep_err_file=$(mktemp)
        if ! filtered=$(printf '%s' "$page_entries" | jq -c --arg pat "$GREP_PATTERN" '[.[] | select(.message | test($pat))]' 2>"$grep_err_file"); then
            err_detail=$(tr -d '\n' < "$grep_err_file" | head -c 300)
            rm -f "$grep_err_file"
            json_error "$TOOL_NAME" "grep filter failed: ${err_detail:-invalid pattern}" "INVALID_ARG" "Provide a valid regex for --grep"
        fi
        rm -f "$grep_err_file"
    else
        filtered="$page_entries"
    fi

    filtered_count=$(echo "$filtered" | jq 'length' 2>/dev/null) || filtered_count=0

    if [[ "$filtered_count" -gt 0 ]]; then
        # Write each page to its own file instead of re-merging into one
        # growing blob via `jq --argjson new "$filtered" ...`. Over ~128KB
        # (easy with 100 entries at realistic message size) --argjson
        # blows past Linux's MAX_ARG_STRLEN and jq fails to exec. That
        # failure used to be `&&`-gated in front of the `mv` that commits
        # the merge, so under `set -e` the failure was swallowed, the
        # loop kept going, and the final result reported a false zero
        # total. Files merged at the end via `jq -s` never touch argv for
        # the content, only file I/O — no such limit.
        printf '%s' "$filtered" > "$WORKDIR/page-$(printf '%04d' "$page").json"
        COLLECTED=$((COLLECTED + filtered_count))
    fi

    # Stop when we have enough matched lines (unless stats mode wants everything)
    if [[ "$STATS_MODE" != true ]] && [[ "$COLLECTED" -ge "$LINES" ]]; then
        break
    fi

    # Check hasMore and get next cursor
    has_more=$(echo "$raw" | jq -r '.hasMore // false' 2>/dev/null) || has_more="false"
    if [[ "$has_more" != "true" ]]; then
        break
    fi

    # Advance cursor based on direction
    if [[ "$DIRECTION" == "backward" ]]; then
        CUR_END=$(echo "$raw" | jq -r '.nextEndTime // empty' 2>/dev/null) || CUR_END=""
        if [[ -z "$CUR_END" ]]; then
            break
        fi
    else
        CUR_START=$(echo "$raw" | jq -r '.nextStartTime // empty' 2>/dev/null) || CUR_START=""
        if [[ -z "$CUR_START" ]]; then
            break
        fi
    fi
done

if compgen -G "$WORKDIR/page-*.json" > /dev/null 2>&1; then
    jq -s 'add // []' "$WORKDIR"/page-*.json > "$MERGED_FILE"
else
    echo '[]' > "$MERGED_FILE"
fi

# Build the result based on mode
if [[ "$STATS_MODE" == true ]]; then
    # Stats mode: return compact summary instead of raw lines
    ALL_MATCHED=$(cat "$MERGED_FILE")
    stats_result=$(echo "$ALL_MATCHED" | jq --argjson scanned "$SCANNED" --arg grep_pat "$GREP_PATTERN" '
        length as $matched |

        # Time window
        (if length > 0 then [.[].timestamp] | sort | {first: first, last: last} else {first: null, last: null} end) as $window |

        # Count by level
        (group_by(.level) | map({(.[0].level): length}) | add // {}) as $by_level |

        # Count by day
        ([.[].timestamp[:10]] | group_by(.) | map({(.[0]): length}) | add // {}) as $by_day |

        # Real statusCode/method/path labels, not regexed out of the message text
        (map(select(.statusCode != null)) | group_by(.statusCode) | map({(.[0].statusCode): length}) | add // {}) as $by_status |

        ([.[] | select(.method != null and .path != null) | "\(.method) \(.path)" | gsub("/[A-Za-z0-9]{15,18}/"; "/:id/")] | group_by(.) | map({key: .[0], count: length}) | sort_by(-.count) | .[:10] | map({(.key): .count}) | add // {}) as $by_endpoint |

        # Duration stats from duration_ms=NNN (no dedicated label for this)
        ([.[] | .message | capture("duration_ms=(?<ms>[0-9]+)") // empty | .ms | tonumber] |
            if length > 0 then
                sort | {
                    count: length,
                    min_ms: first,
                    max_ms: last,
                    avg_ms: ((add / length) | floor),
                    p50_ms: .[length/2 | floor],
                    p95_ms: .[(length * 0.95) | floor],
                    p99_ms: .[(length * 0.99) | floor]
                }
            else null end
        ) as $durations |

        # Sample: first 3 and last 3 matched messages (trimmed)
        (if length > 0 then
            ([.[:3][] | {timestamp, message: (.message[:150])}]) as $head |
            ([.[-3:][] | {timestamp, message: (.message[:150])}]) as $tail |
            {first: $head, last: $tail}
        else null end) as $samples |

        {
            scanned: $scanned,
            matched: $matched,
            grep: (if $grep_pat == "" then null else $grep_pat end),
            window: $window,
            by_level: $by_level,
            by_day: $by_day,
            by_status: $by_status,
            by_endpoint: $by_endpoint,
            durations: $durations,
            samples: $samples
        }
    ' 2>/dev/null) || stats_result='{"error": "failed to compute stats"}'

    if [[ "$PARTIAL" == true ]]; then
        stats_result=$(echo "$stats_result" | jq --arg reason "$PARTIAL_REASON" '. + {partial: true, partial_reason: $reason}')
    fi

    TEXT_HINT=""
    [[ ${#LOG_TEXTS[@]} -gt 0 ]] && TEXT_HINT=" --text \"${LOG_TEXTS[0]}\""
    local_na=$(next_actions \
        "$(next_action "render-logs $SERVICE_ID --lines 50${TEXT_HINT}" "Show matching log lines")" \
        "$(next_action "render-logs $SERVICE_ID --stats --since 1d" "Stats for last 24h")" \
        "$(next_action "render-logs $SERVICE_ID --level error --stats" "Error stats")")

    json_ok "$TOOL_NAME" "$stats_result" "$local_na"
else
    # Normal mode: return log lines
    ALL_ENTRIES=$(cat "$MERGED_FILE")
    truncated=$(json_truncate "$ALL_ENTRIES" "$LINES")

    if [[ "$PARTIAL" == true ]]; then
        truncated=$(echo "$truncated" | jq --arg reason "$PARTIAL_REASON" '. + {partial: true, partial_reason: $reason}')
    fi

    # Add filter metadata when any filtering was applied
    HAS_FILTERS=false
    [[ -n "$GREP_PATTERN" ]] && HAS_FILTERS=true
    [[ ${#LOG_TEXTS[@]} -gt 0 ]] && HAS_FILTERS=true
    [[ ${#LOG_PATHS[@]} -gt 0 ]] && HAS_FILTERS=true

    if [[ "$HAS_FILTERS" == true ]]; then
        TEXTS_JSON="[]"
        PATHS_JSON="[]"
        [[ ${#LOG_TEXTS[@]} -gt 0 ]] && TEXTS_JSON=$(printf '%s\n' "${LOG_TEXTS[@]}" | jq -R . | jq -s '.')
        [[ ${#LOG_PATHS[@]} -gt 0 ]] && PATHS_JSON=$(printf '%s\n' "${LOG_PATHS[@]}" | jq -R . | jq -s '.')

        truncated=$(echo "$truncated" | jq \
            --arg grep "$GREP_PATTERN" \
            --argjson scanned "$SCANNED" \
            --argjson texts "$TEXTS_JSON" \
            --argjson paths "$PATHS_JSON" \
            '. + {scanned: $scanned} + (if $grep != "" then {grep: $grep} else {} end) + (if ($texts | length) > 0 then {text_filter: $texts} else {} end) + (if ($paths | length) > 0 then {path_filter: $paths} else {} end)')
    fi

    local_na=$(next_actions \
        "$(next_action "render-logs $SERVICE_ID --lines 200" "Show more log lines")" \
        "$(next_action "render-logs $SERVICE_ID --level error" "Show only errors")" \
        "$(next_action "render-logs $SERVICE_ID --stats" "Show stats summary")")

    json_ok "$TOOL_NAME" "$truncated" "$local_na"
fi
