# Claude Code sandbox allowlist
# Paths Claude can write to. Everything else is read-only at the kernel level.
# Suffix :ro for read-only access (can read but not modify)
# WARNING: Do not add ~ or ~/* — that defeats the entire sandbox.
# NOTE: ~/.config/cco/dirs is a symlink to this file — both paths read the same content.

# === Project code ===
~/Documents/Development/

# === Runtime / temp ===
/tmp
/tmp/bun-db-safe

# === Package managers & caches ===
~/.bun
~/.bun/install/cache/
~/.cache/prisma

# === Dev tool state (needs read-write) ===
~/.pm2
~/.cmux
~/.portless
~/.agent-browser
~/.chrome-dev-profiles
~/.oracle
~/.codex
~/.local/state/interview/
~/.config/interview/
~/Library/Preferences/.wrangler/logs
~/.cache
~/.playwriter
~/.cache/uv
~/.agent
/Users/blake/Library/Preferences/.wrangler
~/.config/last30days
~/Documents/Last30Days
~/.yarn
~/.peekaboo
~/.local/share/tennis-warehouse-pp-cli/
~/.roughdraft/
~/Library/Developer/CoreSimulator/
~/.cursor
~/.lavish-axi
~/.local/bin

# === Cloud / API credentials (needs read-write for token refresh) ===
~/.sf
~/.sfdx
~/.infisical
~/infisical-keyring/

# === Read-only (Claude can see but not modify) ===
~/Library/Preferences:ro
~/.config/cco:ro
~/.local/bin:ro
~/Documents/Development/tools/sandbox:ro
