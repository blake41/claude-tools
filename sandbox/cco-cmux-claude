#!/usr/bin/env bash
# cco-cmux-claude - run cmux's claude wrapper with one hot spot fixed.
#
# cmux-claude-wrapper's cmux_claude_config_dir_has_session() lists five glob
# words in one `for` statement. Bash expands every word before the first loop
# iteration, so a transcript at depth 1 still walks ~/.claude/projects to
# depth 5 (10k+ dirs here, 1-4s). This shim replaces that one `for` with
# depth-ordered loops that return on the first hit. Same truth value, same
# side effects, nothing else changed.
#
# The wrapper text is patched in memory on every launch and run with
# `bash -c <text> <real-wrapper-path> args`, so $0 is still the real wrapper
# path: every self_dir / resource lookup resolves into the cmux.app bundle
# exactly as before. No patched copy is written to disk, so nothing the sandbox
# can write is ever executed later outside it.
#
# Fallback: if the wrapper or the cmux shim can't be found, or the anchor text
# is not present exactly once (cmux changed the function), exec the stock cmux
# shim unchanged. CCO_FASTWRAP_DISABLE=1 forces that path.
# CCO_STARTUP_TRACE=1 also stamps "wrapper-done" into /tmp/cco-startup-trace.log.
set -u

cco_find_cmux_wrapper() {
    local w=/Applications/cmux.app/Contents/Resources/bin/cmux-claude-wrapper
    if [[ ! -x "$w" && -n "${CMUX_BUNDLED_CLI_PATH:-}" ]]; then
        w="$(dirname "$CMUX_BUNDLED_CLI_PATH")/cmux-claude-wrapper"
    fi
    [[ -x "$w" ]] && printf '%s' "$w"
}

# Not $CMUX_CLAUDE_WRAPPER_SHIM: config.fish repoints it at cco-claude-shim.
cco_find_cmux_shim() {
    local d dirs
    IFS=: read -r -a dirs <<<"${PATH:-}"
    for d in "${dirs[@]}"; do
        case "$d" in */cmux-cli-shims/*|*/cmux-cli-shims)
            [[ -x "$d/claude" ]] && { printf '%s' "$d/claude"; return 0; } ;;
        esac
    done
    local orig="${CMUX_CLAUDE_WRAPPER_SHIM_ORIG:-}"
    [[ -n "$orig" && -x "$orig" ]] && { printf '%s' "$orig"; return 0; }
    return 1
}

cco_stock() {
    local shim
    if shim="$(cco_find_cmux_shim)"; then exec "$shim" "$@"; fi
    exec claude "$@"
}

[[ -n "${CMUX_SURFACE_ID:-}" ]] || cco_stock "$@"
[[ "${CCO_FASTWRAP_DISABLE:-0}" == 1 ]] && cco_stock "$@"

wrapper="$(cco_find_cmux_wrapper)" || cco_stock "$@"
shim="$(cco_find_cmux_shim)" || cco_stock "$@"

read -r -d '' patch_py <<'PY'
import os, sys
text = open(sys.argv[1], 'rb').read()
old = b'''    local transcript
    for transcript in \\
        "$root"/projects/*/"$sid".jsonl \\
        "$root"/projects/*/*/"$sid".jsonl \\
        "$root"/projects/*/*/*/"$sid".jsonl \\
        "$root"/projects/*/*/*/*/"$sid".jsonl \\
        "$root"/projects/*/*/*/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    return 1
'''
new = b'''    local transcript
    for transcript in "$root"/projects/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    for transcript in "$root"/projects/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    for transcript in "$root"/projects/*/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    for transcript in "$root"/projects/*/*/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    for transcript in "$root"/projects/*/*/*/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    return 1
'''
if text.count(old) != 1:
    sys.exit(3)
text = text.replace(old, new)
if os.environ.get('CCO_STARTUP_TRACE'):
    hook = b'cmux_claude_wrapper_exec_resolved_claude() {\n    local target="$1"\n'
    stamp = (b'    printf \'%s %s wrapper-done\\n\' "$(/usr/bin/perl -MTime::HiRes=time -e \'printf q(%.3f), time\')"'
             b' "${CCO_SESSION_ID:-?}" >>/tmp/cco-startup-trace.log 2>/dev/null\n')
    if text.count(hook) == 1:
        text = text.replace(hook, hook + stamp)
sys.stdout.buffer.write(text)
PY

patched="$(/usr/bin/python3 -c "$patch_py" "$wrapper")" || cco_stock "$@"
[[ -n "$patched" ]] || cco_stock "$@"

export CMUX_CLAUDE_WRAPPER_SHIM="$shim"
export CMUX_CLAUDE_WRAPPER_SHIM_ROOT="${shim%/claude}"
exec bash -c "$patched" "$wrapper" "$@"
