#!/bin/bash
# cco-claude-shim — reroute cmux auto-resume through the fish `claude` interceptor.
#
# cmux's restored-session bindings exec "$CMUX_CLAUDE_WRAPPER_SHIM" by absolute
# path via /bin/sh, so the fish claude() function (which routes --resume through
# cco-permissions for Seatbelt + --dangerously-skip-permissions) never fires.
# Fish config repoints CMUX_CLAUDE_WRAPPER_SHIM at this script, which bounces
# the invocation back into fish where the interceptor lives.
#
# Non-resume invocations fall through inside the interceptor to `command claude`,
# which still resolves to cmux's own shim dir in PATH — cmux session tracking is
# preserved on every path. cmux's original shim path is kept in
# CMUX_CLAUDE_WRAPPER_SHIM_ORIG by the fish config block (unused here; the PATH
# fallthrough covers it) so it can be restored by hand if needed.
printf '%s pid=%s ppid=%s surface=%s args=%s\n' "$(date '+%F %T')" "$$" "$PPID" "${CMUX_SURFACE_ID:-}" "$*" >> "$HOME/.cmux/cco-claude-shim.log" 2>/dev/null
# cmux spawns the PTY from pre-layout bounds and resizes it during later layout passes,
# but claude reads its terminal size once at startup and ignores SIGWINCH, so a resume
# that starts too early renders at the intermediate size forever. Hold until the size
# has been stable for ~300ms (cap 2s).
if [ -t 0 ]; then
    prev=""; stable=0; tries=0; first=""
    while [ "$stable" -lt 3 ] && [ "$tries" -lt 20 ]; do
        cur=$(stty size 2>/dev/null)
        [ -z "$first" ] && first=$cur
        if [ "$cur" = "$prev" ]; then stable=$((stable+1)); else stable=0; fi
        prev=$cur; tries=$((tries+1)); sleep 0.1
    done
    printf '%s   size-settle: first=%s final=%s samples=%s\n' "$(date '+%F %T')" "$first" "$cur" "$tries" >> "$HOME/.cmux/cco-claude-shim.log" 2>/dev/null
fi
# config.fish prepends user dirs (~/.local/bin holds the real claude) ahead of cmux's
# per-surface shim dir; the pane shell gets it re-prepended by cmux's --init-command,
# this inner fish does not. Re-prepend so `claude` inside cco still hits cmux's wrapper.
# --no-config: a full `fish -c` re-runs config.fish (0.5-1.0s, worse under N concurrent
# restores) just to find the claude() interceptor. Source only the file that defines it.
cco_fish_file="$HOME/Documents/Development/tools/sandbox/cco-permissions.fish"
if [ -r "$cco_fish_file" ]; then
    exec /opt/homebrew/bin/fish --no-config -c 'test -n "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT"; and test -d "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT"; and set -gx PATH "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT" $PATH; source $argv[1]; and claude $argv[2..-1]' -- "$cco_fish_file" "$@"
fi
exec /opt/homebrew/bin/fish -c 'test -n "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT"; and test -d "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT"; and set -gx PATH "$CMUX_CLAUDE_WRAPPER_SHIM_ROOT" $PATH; claude $argv' -- "$@"
